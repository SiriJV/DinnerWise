# ============================================================================
# DinnerWise Backend Environment Configuration
# ============================================================================
# Copy this file to .env and update with your local values.
# DO NOT commit .env to git - it contains secrets!
# See backend/README.md for setup instructions.

# ============================================================================
# APPLICATION
# ============================================================================

# Node environment: development or production
NODE_ENV=development

# ============================================================================
# SERVER
# ============================================================================

# Backend server port
PORT=3001

# Backend server host (leave as localhost for development)
HOST=localhost

# ============================================================================
# DATABASE
# ============================================================================

# MySQL host
DB_HOST=localhost

# MySQL port
DB_PORT=3306

# MySQL username
DB_USER=root

# MySQL password
DB_PASSWORD=root

# MySQL database name
DB_NAME=dinnerwise

# Maximum number of connections in the pool
DB_CONNECTION_LIMIT=10

# ============================================================================
# AUTHENTICATION (Clerk)
# ============================================================================

# Clerk Secret Key - Get from https://dashboard.clerk.com
# Optional in development, required in production
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_HERE

# Clerk Publishable Key - Get from https://dashboard.clerk.com
# Optional in development, required in production
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_HERE

# ============================================================================
# FRONTEND INTEGRATION
# ============================================================================

# Frontend URL (for CORS configuration)
# In development: http://localhost:5173 (Vite default)
# In production: https://your-domain.com
FRONTEND_URL=http://localhost:5173

# Public API URL that frontend uses to reach backend
# In development: http://localhost:3001
# In production: https://api.your-domain.com
API_PUBLIC_URL=http://localhost:3001

# ============================================================================
# EXTERNAL SERVICES
# ============================================================================

# Email Configuration
CONTACT_EMAIL=contact@example.com
NEWSLETTER_EMAIL=newsletter@example.com
BRAND_NAME=DinnerWise

# TripAdvisor API Key (if using TripAdvisor integration)
# TRIPADVISOR_API_KEY=your_key_here

# Google Generative AI Key (if using Gemini)
# GOOGLE_GENERATIVE_AI_KEY=your_key_here

# Resend Email API Key (if using email service)
# RESEND_API_KEY=your_key_here
